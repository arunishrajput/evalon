# ==================================================
# EVALON — Environment Configuration
# Copy this file to .env and fill in real values.
# ==================================================

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- PostgreSQL ---
POSTGRES_USER=evalon
POSTGRES_PASSWORD=evalon
POSTGRES_DB=evalon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async DSN used directly by the backend/worker (docker-compose overrides the
# host portion to `postgres` automatically for in-container use).
DATABASE_URL=postgresql+asyncpg://evalon:evalon@localhost:5432/evalon

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
JWT_SECRET=change-me-to-a-long-random-string-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ollama / Model Queue ---
# macOS local dev: point at the NATIVE host Ollama install (Metal GPU accelerated).
# Docker Desktop cannot pass Metal through to a container, so run Ollama natively
# and let containers reach it via host.docker.internal. If you deliberately want the
# containerized Ollama profile instead, use OLLAMA_BASE_URL=http://ollama:11434 and
# start compose with `--profile docker-ollama`.
OLLAMA_BASE_URL=http://host.docker.internal:11434
INFERENCE_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
MODEL_LOCK_TIMEOUT_SECONDS=600

# --- Repository ingestion limits ---
WORKSPACE_DIR=/workspace/repos
MAX_REPO_SIZE_MB=50
MAX_FILE_COUNT=5000
CLONE_TIMEOUT_SECONDS=120

# --- GitHub API (unauthenticated calls work but are rate-limited to 60/hr;
#     set a token to raise the limit for demo days) ---
GITHUB_API_TOKEN=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost,https://your-evalon-frontend.vercel.app

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
